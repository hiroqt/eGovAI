{
  "rewrites": [
    {
      "source": "/egov-api/:path*",
      "destination": "https://platforms-api.e.gov.ph/egov-sso/:path*"
    },
    {
      "source": "/integration-api/:path*",
      "destination": "https://platforms-api.e.gov.ph/egov-ai/:path*"
    },
    {
      "source": "/everify-api/:path*",
      "destination": "https://platforms-api.e.gov.ph/everify/:path*"
    },
    {
      "source": "/emessage-api/:path*",
      "destination": "https://platforms-api.e.gov.ph/emessage/:path*"
    },
    {
      "source": "/egovpay-api/:path*",
      "destination": "https://platforms-api.e.gov.ph/egovpay/:path*"
    },
    {
      "source": "/face-liveness-api/:path*",
      "destination": "https://platforms-api.e.gov.ph/face-liveness/:path*"
    },
    {
      "source": "/ereport-api/:path*",
      "destination": "https://platforms-api.e.gov.ph/ereport/:path*"
    },
    {
      "source": "/compass-api/:path*",
      "destination": "https://platforms-api.e.gov.ph/compass/:path*"
    },
    {
      "source": "/((?!api|egov-api|integration-api|everify-api|emessage-api|egovpay-api|face-liveness-api|ereport-api|compass-api).*)",
      "destination": "/index.html"
    }
  ]
}

